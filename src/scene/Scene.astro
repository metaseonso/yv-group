---
// The paper world: layers at different depths. The film script moves the layers and stands the pieces up.
import { FIRST } from '../film/beats';
import { figureSvg } from './figure';
import Flame from './Flame.astro';
import { BRAZIER_SPOTS, PEOPLE, ROWS, TORCH_SPOTS, TREES, type Row } from './layout';
import { GRASS, MOON, PINE, ridge } from './shapes';

const box = (x: number, y: number, w: number, h: number) => `--x:${x};--y:${y};--w:${w};--h:${h}`;
const rows: Row[] = ['back', 'mid', 'front'];
const at = (row: Row) => ROWS[row];
const dance = (i: number) => `--dt:${(0.9 + ((i * 37) % 7) / 10).toFixed(2)}s;--dd:${(-((i * 53) % 11) / 10).toFixed(2)}s`;
const paths = [
  'M150 255 C 700 230, 1500 160, 1985 132',
  'M3850 258 C 3300 235, 2500 165, 2015 132',
  'M700 258 C 1200 220, 1750 170, 1990 136',
  'M3300 258 C 2800 222, 2250 170, 2010 136',
];
---
<div class="world" data-world aria-hidden="true">
  <div class="layer" data-d="0.08">
    <div class="horizon-glow"></div>
    <svg class="moon" viewBox="0 0 100 100"><path d={MOON} /></svg>
  </div>
  <div class="layer" data-d="0.3">
    <svg class="piece ridge far" style={box(0, 0, 4000, 460)} viewBox="0 0 4000 460" preserveAspectRatio="none"><path d={ridge(460, 380, 46, 1.3)} /></svg>
  </div>
  <div class="layer" data-d="0.55">
    {TREES.map((t) => (
      <svg class="piece tree" style={box(t.x, 262, t.h * 0.5, t.h)} viewBox="0 0 100 200"><path d={PINE} /></svg>
    ))}
    <svg class="piece ridge mid" style={box(0, 0, 4000, 330)} viewBox="0 0 4000 330" preserveAspectRatio="none"><path d={ridge(330, 290, 22, 4.1)} /></svg>
  </div>
  {rows.map((row) => (
    <div class="layer" data-d={at(row).d} data-row={row}>
      {row === 'back' && (
        <svg class="piece floor" style={box(0, 0, 4000, 260)} viewBox="0 0 4000 260" preserveAspectRatio="none">
          <path class="ground" d="M0 260 L0 18 C 900 6, 3100 6, 4000 18 L4000 260 Z" />
          {paths.map((d, i) => <path class="trail" pathLength="1" d={d} data-path={`${6.6 + i * 0.15} ${7.6 + i * 0.15}`} />)}
        </svg>
      )}
      {row === 'mid' && (
        <>
          <div class="piece rocket" style={box(0, at('mid').y, 22, 110)} data-until="0.32">
            <svg viewBox="0 0 22 110"><path d="M11 0 L19 18 L19 52 L3 52 L3 18 Z M10 52 L12 52 L12 110 L10 110 Z" /></svg>
          </div>
          <div class="piece bonfire" style={box(0, at('mid').y - 6, 170, 240)} data-pop={FIRST.pop - 0.15}>
            <Flame ignite={FIRST.pop + 0.1} width={50} glow={720} embers={14} />
            <svg class="logs" viewBox="0 0 170 50"><path d="M10 44 L150 14 L160 26 L22 50 Z M160 44 L20 14 L10 26 L148 50 Z" /></svg>
          </div>
        </>
      )}
      {BRAZIER_SPOTS.filter((l) => l.row === row).map((l) => (
        <div class="piece brazier" style={box(l.x, at(row).y, 80 * at(row).s, 200 * at(row).s)} data-pop={l.pop}>
          <Flame ignite={l.pop + 0.3} width={72} glow={380} embers={4} />
          <svg class="stand" viewBox="0 0 80 120"><path d="M8 14 L72 14 L62 38 L18 38 Z M36 38 L44 38 L44 120 L36 120 Z M38 70 L12 120 L6 117 Z M42 70 L68 120 L74 117 Z" /></svg>
        </div>
      ))}
      {TORCH_SPOTS.filter((l) => l.row === row).map((l) => (
        <div class="piece torch" style={box(l.x, at(row).y, 40 * at(row).s, 260 * at(row).s)} data-pop={l.pop}>
          <Flame ignite={l.pop + 0.3} width={95} glow={260} />
          <svg class="pole" viewBox="0 0 40 200"><path d="M12 0 L28 0 L24 26 L16 26 Z M17 26 L23 26 L22 200 L18 200 Z" /></svg>
        </div>
      ))}
      <div class="crowd">
        {PEOPLE.map((p, i) => ({ p, i })).filter(({ p }) => p.row === row).map(({ p, i }) => {
          const s = (p.s ?? 1) * at(row).s;
          const walk = p.walk ? `${p.walk[0] - p.x} ${p.walk[1]} ${p.walk[2]}` : undefined;
          return (
            <div class="piece fig" style={box(p.x, at(row).y, 60 * s, 120 * s)} data-pop={p.pop} data-walk={walk}>
              <svg class="dancer" viewBox="0 0 60 120" style={dance(i)} set:html={figureSvg(p.arms, p.legs ?? 'stand', p.dress, p.bun)} />
            </div>
          );
        })}
      </div>
    </div>
  ))}
  <div class="layer" data-d="1.4">
    <svg class="piece grass" style={box(-560, -10, 520, 210)} viewBox="0 0 300 160" preserveAspectRatio="none"><path d={GRASS} /></svg>
    <svg class="piece grass flip" style={box(560, -10, 520, 210)} viewBox="0 0 300 160" preserveAspectRatio="none"><path d={GRASS} /></svg>
  </div>
</div>
<span class="unit-probe" data-probe aria-hidden="true"></span>
